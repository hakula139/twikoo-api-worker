{
  "name": "twikoo-api-worker",
  "description": "Cloudflare Workers backend for the Twikoo comment system, backed by D1 and R2.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/worker.ts",
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "check": "tsc --noEmit",
    "db:fixture": "drizzle-kit export > tests/fixtures/schema.sql",
    "db:push": "drizzle-kit push",
    "deploy": "wrangler deploy --minify",
    "dev": "wrangler dev",
    "format": "prettier --check .",
    "lint": "pnpm lint:md && pnpm lint:js",
    "lint:js": "eslint .",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "postinstall": "node scripts/bundle-trim.mjs",
    "spellcheck": "cspell --no-progress \"**/*\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.1",
    "twikoo-func": "^1.7.20",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260830.1",
    "@types/node": "^26.4.0",
    "@vitest/coverage-istanbul": "^4.1.11",
    "cspell": "^10.1.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
