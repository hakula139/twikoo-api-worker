{
  "name": "twikoo-api-worker",
  "description": "Cloudflare Workers backend for the Twikoo comment system, backed by D1 and R2.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/worker.ts",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "check": "tsc --noEmit",
    "db:fixture": "drizzle-kit export > tests/fixtures/schema.sql",
    "db:push": "drizzle-kit push",
    "deploy": "wrangler deploy --minify",
    "dev": "wrangler dev",
    "format": "prettier --check .",
    "lint": "pnpm lint:md && pnpm lint:js",
    "lint:js": "eslint .",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "spellcheck": "cspell --no-progress \"**/*\"",
    "test": "vitest run",
    "test:smoke": "bash scripts/smoke-test.sh",
    "test:watch": "vitest"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "twikoo-func": "1.7.24",
    "xss": "^1.0.17"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@cloudflare/workers-types": "^5.20261031.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-istanbul": "^5.0.5",
    "cspell": "^10.4.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
