{
  "name": "twikoo-api-worker",
  "description": "Cloudflare Workers backend for the Twikoo comment system, backed by D1 and R2.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/worker.ts",
  "scripts": {
    "db:fixture": "drizzle-kit export > tests/fixtures/schema.sql",
    "db:push": "drizzle-kit push",
    "deploy": "wrangler deploy --minify",
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:bundle": "./scripts/bundle-test.nu",
    "test:smoke": "./scripts/smoke-test.nu",
    "test:watch": "vitest"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "entities": "^8.1.0",
    "fast-xml-parser": "^5.11.2",
    "twikoo-func": "1.7.24",
    "xss": "^1.0.17"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@cloudflare/workers-types": "^5.20261031.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-istanbul": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0",
      "onFail": "error"
    }
  }
}
